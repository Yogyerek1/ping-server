@* Shared/Services/Email/Templates/Welcome.cshtml *@
@model Ping.Server.Shared.Services.Email.Models.WelcomeEmailModel

<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f8f9fa; margin: 0; padding: 40px 0; }
        .container { background-color: #ffffff; max-width: 550px; margin: 0 auto; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); padding: 30px; }
        .header { text-align: center; border-bottom: 1px solid #eee; padding-bottom: 20px; }
        .btn { display: inline-block; background-color: #6366f1; color: #ffffff !important; padding: 12px 24px; border-radius: 6px; text-decoration: none; font-weight: bold; margin-top: 15px; }
        .feature-list { background-color: #f3f4f6; padding: 15px 25px; border-radius: 6px; margin-top: 20px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h2>Üdvözlünk a Ping-ben, @Model.Name! 🎉</h2>
        </div>
        <p>Köszönjük, hogy regisztráltál. Kérjük, aktiváld a fiókodat az alábbi gombra kattintva:</p>
        
        <div style="text-align: center;">
            <a href="@Model.ConfirmUrl" class="btn">Fiók Aktiválása</a>
        </div>

        @if (Model.Features != null && Model.Features.Any())
        {
            <div class="feature-list">
                <h4>Miket próbálhatsz ki?</h4>
                <ul>
                    @foreach (var feature in Model.Features)
                    {
                        <li>@feature</li>
                    }
                </ul>
            </div>
        }
    </div>
</body>
</html>