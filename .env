POSTGRES_DB=ping_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password

ASPNETCORE_ENVIRONMENT=Production

POSTGRES_HOST_PORT=5432
API_HOST_PORT=5276

# Set the target Docker network name (e.g. 'app-net').
# Leave empty to let Docker Compose generate a default isolated network.
NETWORK=

# Set to 'true' if the network specified in 'NETWORK' already exists on the host (e.g. Nginx proxy network).
# Set to 'false' if Docker Compose should create a new network.
HAS_EXTERNAL_NETWORK=false